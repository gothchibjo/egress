{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/gothchibjo/egress/schema/result-v1.json",
  "title": "Egress baseline result envelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "results"],
  "properties": {
    "schema_version": { "const": "v1" },
    "mode": { "enum": ["unprivileged", "elevated"] },
    "cancelled": { "type": "boolean" },
    "results": {
      "type": "array",
      "items": { "$ref": "#/$defs/result" }
    },
    "verdict": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verdict", "counts"],
      "properties": {
        "verdict": { "enum": ["healthy", "degraded", "blocked"] },
        "counts": {
          "type": "object",
          "additionalProperties": false,
          "required": ["pass", "warn", "fail", "skipped"],
          "properties": {
            "pass": { "type": "integer", "minimum": 0 },
            "warn": { "type": "integer", "minimum": 0 },
            "fail": { "type": "integer", "minimum": 0 },
            "skipped": { "type": "integer", "minimum": 0 }
          }
        },
        "finding": { "$ref": "#/$defs/result" }
      }
    },
    "classification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope", "summary"],
      "properties": {
        "scope": {
          "enum": ["none", "local-link", "gateway", "dns", "upstream"]
        },
        "summary": { "type": "string", "minLength": 1 }
      }
    },
    "destinations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "host", "transport", "purpose"],
        "properties": {
          "kind": {
            "enum": ["resolver", "doh", "anchor", "captive-portal", "path-mtu"]
          },
          "host": { "type": "string", "minLength": 1 },
          "port": { "type": "integer", "minimum": 0, "maximum": 65535 },
          "transport": {
            "enum": ["udp+tcp", "tcp", "https", "http", "icmp", "icmp-df"]
          },
          "purpose": { "type": "string", "minLength": 1 }
        }
      }
    }
  },
  "$defs": {
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "check_id",
        "status",
        "target",
        "method",
        "measurements",
        "timestamp"
      ],
      "properties": {
        "check_id": { "type": "string", "minLength": 1 },
        "status": { "enum": ["pass", "warn", "fail", "skipped"] },
        "target": { "type": "string", "minLength": 1 },
        "method": { "type": "string", "minLength": 1 },
        "measurements": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "value"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "value": { "type": "string", "minLength": 1 },
              "unit": { "type": "string" }
            }
          }
        },
        "timestamp": { "type": "string", "format": "date-time" },
        "diagnostic": { "type": "string" },
        "error": { "type": "string" }
      }
    }
  }
}
